---
interface Props {
  current?: 'home' | 'how-it-works';
}

const { current = 'home' } = Astro.props;
const repo = 'https://github.com/felipcsousa/siftos';
---

<div class="masthead">
  <a class="masthead-brand" href="/siftos/">
    <svg class="masthead-mark" width="34" height="34" viewBox="0 0 32 32" aria-hidden="true">
      <rect width="32" height="32" fill="none" stroke="#7f8698" stroke-width="1.5" />
      <rect x="3" y="3" width="26" height="26" fill="none" stroke="#a9afbd" stroke-width="1" />
      <rect x="12" y="14" width="8" height="4" fill="#9e2f22" />
    </svg>
    <span class="masthead-text">
      <span class="masthead-name">SiftOS</span>
      <span class="masthead-tag">Product Decision Intelligence</span>
    </span>
  </a>
  <nav class="site-nav" aria-label="Site">
    <a href="/siftos/" class:list={['site-nav-link', current === 'home' && 'site-nav-link--current']}>
      Home
    </a>
    <a href="/siftos/how-it-works/" class:list={['site-nav-link', current === 'how-it-works' && 'site-nav-link--current']}>
      How it works
    </a>
    <a class="site-nav-link" href={repo}>GitHub</a>
  </nav>
</div>