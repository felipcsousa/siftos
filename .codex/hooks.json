{
  "description": "Optional SiftOS product-decision lifecycle hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/skills/siftos/scripts/hook-codex.mjs session_start",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/skills/siftos/scripts/hook-codex.mjs prompt_submit",
            "additionalContextLimit": 1500
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/skills/siftos/scripts/hook-codex.mjs before_mutation"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/skills/siftos/scripts/hook-codex.mjs after_mutation"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/skills/siftos/scripts/hook-codex.mjs context_compact"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/skills/siftos/scripts/hook-codex.mjs turn_stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/skills/siftos/scripts/hook-codex.mjs session_end"
          }
        ]
      }
    ]
  }
}
