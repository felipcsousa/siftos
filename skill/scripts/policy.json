{
  "build_authorizing_statuses": [
    "accepted",
    "building",
    "shipped",
    "measuring"
  ],
  "ship_gate_statuses": [
    "accepted",
    "building",
    "shipped",
    "measuring"
  ],
  "guard": {
    "l3": [
      "\\bpricing\\b",
      "\\bbilling\\b",
      "\\bsubscriptions?\\b",
      "\\bpaywall\\b",
      "\\bpayments?\\b",
      "\\bstripe\\b",
      "\\baccount model\\b",
      "\\bmarketplace\\b",
      "\\bbusiness model\\b",
      "\\b(?:pricing|billing|subscription) plans?\\b"
    ],
    "l2": [
      "\\breferrals?\\b",
      "\\buser invitations?\\b",
      "\\binvite users?\\b",
      "\\bdata export\\b",
      "\\bnotifications?\\b",
      "\\boauth\\b",
      "\\b(?:log[ -]?in|sign[ -]?in)\\b",
      "\\bintegrations?\\b",
      "\\bonboard(?:ing)?\\b",
      "\\bpermissions?\\b",
      "\\bworkspaces?\\b"
    ],
    "l1": [
      "\\bcopy\\b",
      "\\bcta\\b",
      "\\blabel\\b",
      "\\btooltip\\b",
      "\\.css\\b",
      "\\bspacing\\b",
      "\\bbutton text\\b"
    ],
    "non_product_paths": [
      "(?:^|/)(?:test|tests|__tests__|docs?|examples?|fixtures?)(?:/|$)",
      "\\.(?:md|txt|snap)$"
    ],
    "candidate": {
      "obvious_product": [
        "\\b(add|introduce|launch|remove|change|redesign|enable|disable|monetiz|pricing|subscription|referral|onboard|oauth|notification|marketplace|paywall)\\b"
      ],
      "technical": [
        "\\b(fix|refactor|rename variable|failing test|lint|format|dependency upgrade|type error)\\b"
      ],
      "possible_product": [
        "\\b(user|customer|flow|screen|cta|copy|behavior|experience|feature)\\b"
      ]
    }
  }
}
