{
  "name": "@felipcsousa/siftos",
  "version": "0.2.1",
  "description": "Product Decision Intelligence for AI-native teams. Repository-native agent skill + deterministic CLI. Your product memory belongs to your repository, not your AI vendor.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "siftos": "dist/entry.js"
  },
  "files": [
    "dist",
    "skill"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-skill.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
